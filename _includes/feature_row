{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature__wrapper">

  {% for f in feature_row %}
    <div class="feature__item{% if include.type %}--{{ include.type }}{% endif %}">
      <div class="archive__item">
        {% if f.image_path %}
          <div class="archive__item-teaser">
            <img src="{{ f.image_path | relative_url }}"
                 alt="{% if f.alt %}{{ f.alt }}{% endif %}">
            {% if f.image_caption %}
              <span class="archive__item-caption">{{ f.image_caption | markdownify | remove: "<p>" | remove: "</p>" }}</span>
            {% endif %}
          </div>
        {% endif %}

        <div class="archive__item-body">
          {% if f.title %}
            <h2 id="{{f.title | slugify}}" class="archive__item-title">{{ f.title }}</h2>
          {% endif %}

          {% if f.excerpt %}
            <div class="archive__item-excerpt">
              {{ f.excerpt | markdownify }}
            </div>
          {% endif %}

          {% comment %}
            Buttons come from two sources, emitted in this order:

              url / url2 / url3   the original keys, read through a loop rather
                                  than spelled out one at a time, so they keep
                                  working exactly as before
              buttons:            a list of {url, btn_label, btn_class} maps with
                                  no ceiling, for venue groups larger than three

            A `buttons` entry with no btn_class inherits the item's, the same way
            btn_class2 and btn_class3 always have.
          {% endcomment %}
          {% capture feature_row_buttons %}
            {%- assign legacy_keys = "url,url2,url3" | split: "," -%}
            {%- for key in legacy_keys -%}
              {%- assign href = f[key] -%}
              {%- if href -%}
                {%- assign suffix = key | remove_first: "url" -%}
                {%- assign class_key = "btn_class" | append: suffix -%}
                {%- assign label_key = "btn_label" | append: suffix -%}
                {%- assign btn_class = f[class_key] | default: f.btn_class -%}
                {%- assign btn_label = f[label_key] | default: site.data.ui-text[site.locale].more_label | default: "Learn More" -%}
                <a href="{{ href | relative_url }}" class="btn {{ btn_class }}">{{ btn_label }}</a>
              {% endif -%}
            {%- endfor -%}
            {%- for b in f.buttons -%}
              {%- if b.url -%}
                {%- assign btn_class = b.btn_class | default: f.btn_class -%}
                {%- assign btn_label = b.btn_label | default: site.data.ui-text[site.locale].more_label | default: "Learn More" -%}
                <a href="{{ b.url | relative_url }}" class="btn {{ btn_class }}">{{ btn_label }}</a>
              {% endif -%}
            {%- endfor -%}
          {% endcapture %}

          {% assign feature_row_buttons = feature_row_buttons | strip %}
          {% if feature_row_buttons != "" %}
            <p>{{ feature_row_buttons }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}

</div>
